circuit-trace 1
# Expectations from public documentation: a redstone lamp lights as soon as it is
# powered and turns off 4 game ticks after losing power. Change order is not asserted.
title Redstone lamp switches on at once and off after four ticks
game-version 1.21.8
source documented_behavior
harness -
mechanisms redstone_lamp
area 0 0 0 1 0 0
ticks 8

at 0 set 0 0 0 minecraft:lever[face=floor,facing=east,powered=false]
at 0 set 1 0 0 minecraft:redstone_lamp[lit=false]
at 1 use 0 0 0
at 3 use 0 0 0

block 0 1 0 0 minecraft:redstone_lamp[lit=false]
block 1 1 0 0 minecraft:redstone_lamp[lit=true]
block 6 1 0 0 minecraft:redstone_lamp[lit=true]
block 7 1 0 0 minecraft:redstone_lamp[lit=false]
